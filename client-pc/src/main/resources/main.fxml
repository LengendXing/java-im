<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.im.client.controller.MainController"
            styleClass="main-root">

    <!-- Left: Session Panel -->
    <left>
        <VBox styleClass="session-panel" prefWidth="280">
            <HBox styleClass="session-header" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <Label text="Messages" styleClass="session-header-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+" onAction="#onCreateGroup" styleClass="icon-button"
                        prefWidth="30" prefHeight="30"/>
                <Button text="Logout" onAction="#onLogout" styleClass="logout-button"/>
            </HBox>
            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <Tab text="Sessions">
                    <ListView fx:id="sessionListView" styleClass="session-list" VBox.vgrow="ALWAYS"/>
                </Tab>
                <Tab text="Requests" onSelectionChanged="#onFriendRequestsTabChanged">
                    <ListView fx:id="friendRequestListView" styleClass="session-list" VBox.vgrow="ALWAYS"/>
                </Tab>
                <Tab text="Friends" onSelectionChanged="#onFriendsTabChanged">
                    <VBox spacing="4">
                        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="search-bar">
                            <TextField fx:id="friendSearchField" promptText="Search users..." HBox.hgrow="ALWAYS"/>
                            <Button text="Search" onAction="#onSearchUsers"/>
                            <Button text="Add" onAction="#onAddFriend"/>
                        </HBox>
                        <ListView fx:id="friendListView" styleClass="session-list" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </Tab>
                <Tab text="Search" onSelectionChanged="#onSearchTabChanged">
                    <VBox spacing="4">
                        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="search-bar">
                            <TextField fx:id="msgSearchField" promptText="Search messages..." HBox.hgrow="ALWAYS"/>
                            <Button text="Search" onAction="#onSearchMessages"/>
                        </HBox>
                        <ListView fx:id="msgSearchResultListView" styleClass="session-list" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </Tab>
                <Tab text="Settings">
                    <VBox spacing="8" styleClass="settings-panel">
                        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                        <Label fx:id="profileNickname" styleClass="settings-title"/>
                        <Label fx:id="profileUsername" style="-fx-text-fill: #999999;"/>
                        <Separator/>
                        <CheckBox fx:id="darkModeCheckBox" text="Dark Mode" onAction="#onToggleDarkMode"/>
                        <Separator/>
                        <Label text="java-im v0.5.0" style="-fx-text-fill: #999999;"/>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </left>

    <!-- Center: Chat Area -->
    <center>
        <VBox styleClass="chat-panel">
            <!-- Chat Header -->
            <HBox styleClass="chat-header" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="12" right="16" bottom="12" left="16"/>
                </padding>
                <Label fx:id="chatTargetLabel" text="Select a conversation" styleClass="chat-target-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="groupInviteButton" text="Invite" onAction="#onGroupInvite"
                        styleClass="toolbar-button" visible="false"/>
                <Button fx:id="groupKickButton" text="Kick" onAction="#onGroupKick"
                        styleClass="toolbar-button" visible="false"/>
                <Button fx:id="groupDissolveButton" text="Dissolve" onAction="#onGroupDissolve"
                        styleClass="toolbar-button-danger" visible="false"/>
            </HBox>

            <Separator/>

            <!-- Message List -->
            <ListView fx:id="messageListView" styleClass="message-list" VBox.vgrow="ALWAYS"/>

            <Separator/>

            <!-- Input Area -->
            <HBox styleClass="input-area" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="8" right="12" bottom="8" left="12"/>
                </padding>
                <Button fx:id="fileUploadButton" text="&#128206;" onAction="#onFileUpload"
                        styleClass="file-upload-button" disable="true"/>
                <TextArea fx:id="messageInput" styleClass="message-input"
                          prefRowCount="3" wrapText="true"
                          promptText="Type a message..."
                          disable="true" HBox.hgrow="ALWAYS"/>
                <Button fx:id="sendButton" text="Send" onAction="#onSend"
                        styleClass="send-button" disable="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
