{
  "annotations": {
    "list": [
      { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" }
    ]
  },
  "editable": true,
  "title": "Java IM Dashboard",
  "uid": "java-im",
  "panels": [
    { "title": "Connections", "type": "stat", "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }, "targets": [{ "expr": "im_connections", "refId": "A" }] },
    { "title": "Messages/sec", "type": "stat", "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }, "targets": [{ "expr": "rate(im_messages_total[1m])", "refId": "A" }] },
    { "title": "Error Rate", "type": "stat", "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }, "targets": [{ "expr": "rate(im_errors_total[5m])", "refId": "A" }] },
    { "title": "Redis Hit Rate", "type": "stat", "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }, "targets": [{ "expr": "im_redis_hit_rate", "refId": "A" }] },
    { "title": "Message Latency P99", "type": "graph", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }, "targets": [{ "expr": "histogram_quantile(0.99, rate(im_message_duration_bucket[5m]))", "refId": "A" }] },
    { "title": "Connections Over Time", "type": "graph", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }, "targets": [{ "expr": "im_connections", "refId": "A" }] }
  ],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "5s"
}
