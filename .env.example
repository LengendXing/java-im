# Server
IM_TCP_PORT=8800
IM_WS_PORT=8801
IM_HTTP_PORT=8080
IM_JWT_SECRET=change-me-in-production
IM_JWT_TTL_DAYS=7
IM_WORKER_ID=1

# Cluster
IM_CLUSTER_ENABLED=true

# Redis
IM_REDIS_HOST=127.0.0.1
IM_REDIS_PORT=6379
IM_REDIS_PASSWORD=
IM_REDIS_DATABASE=0

# MySQL
IM_MYSQL_HOST=127.0.0.1
IM_MYSQL_PORT=3306
IM_MYSQL_DB=im_db
IM_MYSQL_USER=im_user
IM_MYSQL_PASSWORD=im_pass_2024

# Folkmq
IM_FOLKMQ_HOST=127.0.0.1
IM_FOLKMQ_PORT=18602
IM_FOLKMQ_APP_NAME=im-server

# APNs (requires Apple Developer Account)
IM_APNS_ENABLED=false
IM_APNS_BUNDLE_ID=
IM_APNS_P8_PATH=
IM_APNS_TEAM_ID=
IM_APNS_KEY_ID=

# FCM (requires Google Service Account)
IM_FCM_ENABLED=false
IM_FCM_CREDENTIALS_PATH=

# RNacos (service registry)
IM_NACOS_ENABLED=false
IM_NACOS_SERVER_ADDR=127.0.0.1:8848

# Feishu Webhook (dead letter alerts)
IM_FEISHU_WEBHOOK=

# dufs File Server
DUFS_URL=http://127.0.0.1:5100
DUFS_UPLOAD_DIR=/root/java-im/uploads

# Web Client
VITE_WS_URL=ws://localhost:8801
VITE_API_URL=http://localhost:8080/api
